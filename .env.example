# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Contrasena de los usuarios de Oracle Cloud (la misma para los 6 microservicios)
DB_PASSWORD=tu_password_aqui

# Clave para firmar los tokens JWT (minimo 32 caracteres, igual en todos los servicios)
JWT_SECRET=cambia_esto_por_una_clave_larga_de_al_menos_32_caracteres

# Ruta al wallet de Oracle al correr desde el IDE (en Docker se usa /app/wallet)
TNS_ADMIN_PATH=../wallet
